  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Units & format"
      },
      {
        "type": "text",
        "defaultValue": "Temperature and wind units now follow whatever you picked in the Pebble app, so they are no longer set here."
      },
      {
        "type": "radiogroup",
        "messageKey": "date_order_select",
        "label": "Date format",
        "defaultValue": "DMY",
        "options": [
          {
            "label": "DD/MM",
            "value": "DMY"
          },
          {
            "label": "MM/DD",
            "value": "MDY"
          }
        ]
      },
      {
        "type": "toggle",
        "messageKey": "feels_like_toggle",
        "label": "Show feels-like temperature",
        "description": "Applies to both the wide and the small weather tile.",
        "defaultValue": true
      },
      {
        "type": "toggle",
        "messageKey": "wind_bft_toggle",
        "label": "Show wind in Beaufort",
        "defaultValue": false
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Week numbers tile"
      },
      {
        "type": "text",
        "defaultValue": "Top line is the ISO week number. ISO weeks run from Monday to Sunday."
      },
      {
        "type": "text",
        "defaultValue": "The second line is your own week count. Take it from a start date, or from a CSV you host online."
      },
      {
        "type": "toggle",
        "messageKey": "week_use_csv",
        "label": "Use an online CSV",
        "defaultValue": false
      },
      {
        "type": "input",
        "messageKey": "week_ref_date",
        "label": "Offset week start date",
        "attributes": {
          "type": "date",
          "placeholder": "YYYY-MM-DD"
        }
      },
      {
        "type": "input",
        "messageKey": "week_csv_url",
        "label": "CSV URL",
        "attributes": {
          "type": "url",
          "placeholder": "https://raw.githubusercontent.com/..."
        }
      },
      {
        "type": "text",
        "defaultValue": "<u>Start date:</u><br>Counting begins at week 00 for whichever ISO week contains that date.<br><u>CSV:</u><br>https://github.com/Moaske/PebbleMetroWP8 for further details on formatting."
      }
    ]
  },
  {
    "type": "text",
    "defaultValue": "Steps, HR, calories and sleep are read directly from Pebble Health on your watch. Just make sure you enable the Health permission."
