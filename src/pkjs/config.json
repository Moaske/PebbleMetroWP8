  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Week numbers tile"
      },
      {
        "type": "text",
        "defaultValue": "Top line is the ISO week number. ISO weeks run from Monday to Sunday."
      },
      {
        "type": "text",
        "defaultValue": "The second line is your own week count. Take it from a start date, or from a CSV you host online."
      },
      {
        "type": "toggle",
        "messageKey": "week_use_csv",
        "label": "Use an online CSV",
        "defaultValue": false
      },
      {
        "type": "input",
        "messageKey": "week_ref_date",
        "label": "Offset week start date",
        "attributes": {
          "type": "date",
          "placeholder": "YYYY-MM-DD"
        }
      },
      {
        "type": "input",
        "messageKey": "week_csv_url",
        "label": "CSV URL",
        "attributes": {
          "type": "url",
          "placeholder": "https://raw.githubusercontent.com/..."
        }
      },
      {
        "type": "text",
        "defaultValue": "<u>Start date:</u><br>Counting begins at week 00 for whichever ISO week contains that date.<br><u>CSV:</u><br>https://github.com/Moaske/PebbleMetroWP8 for further details on formatting."
      }
    ]
  },
  {
    "type": "text",
    "defaultValue": "Steps and sleep are read directly from Pebble Health on your watch. Just make sure Pebble Health is enabled in the Pebble app (Apps/Timeline tab)."
